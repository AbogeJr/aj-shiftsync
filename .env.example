# The database. This is the only variable the app requires.
#
# On Railway: add a Postgres service to the project and reference it, so the
# value tracks the database automatically:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
#
# Locally: use the Postgres service's PUBLIC url (Railway's Variables tab,
# DATABASE_PUBLIC_URL). The internal postgres.railway.internal host only
# resolves from inside the Railway project.
DATABASE_URL="postgresql://user:password@host:5432/railway"

# Secret for signing session cookies (demo auth, see README).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-me-with-a-long-random-string"
